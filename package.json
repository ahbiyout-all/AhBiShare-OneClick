{
  "name": "ahbishare-oneclick",
  "version": "1.3.1",
  "private": true,
  "license": "MIT",
  "main": "main.js",
  "description": "AhBiShare OneClick - 1-Click Host & Client LAN Shared Folder Setup & Legacy Windows Compatibility Utility",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": {
    "name": "AhBiYout",
    "url": "https://github.com/ahbiyout-all/AhBiShare-OneClick"
  },
  "homepage": "https://github.com/ahbiyout-all/AhBiShare-OneClick",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "start": "electron .",
    "electron:dev": "electron . --dev",
    "electron:build": "vite build && electron-builder --win",
    "electron:build:lite": "node scripts/build_lite_exe.js --lite-only",
    "electron:build:win7": "node scripts/build_win7_exe.js",
    "electron:build:all": "node scripts/build_lite_exe.js --all",
    "verify": "node scripts/verify_portable_release.js",
    "verify:share-oneclick": "node scripts/verify_portable_release.js",
    "version:bump": "node scripts/bump_version.js"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.5.3",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.ahbiyout.ahbishare.oneclick",
    "productName": "AhBiShare_OneClick",
    "copyright": "Copyright © 2026 AhBiYout. All rights reserved.",
    "compression": "maximum",
    "asar": true,
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "portableStore.js",
      "portableUpdater.js",
      "localeHelper.js",
      "package.json",
      "icon.ico",
      "public/config.json",
      "LICENSE",
      "NOTICE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "scripts/upgradedHostGuestUnblock.bat",
        "to": "scripts/upgradedHostGuestUnblock.bat"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "AhBiShare_OneClick_v${version}.${ext}",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AhBiShare OneClick",
      "artifactName": "AhBiShare_OneClick-Setup_v${version}.${ext}"
    },
    "portable": {
      "artifactName": "AhBiShare_OneClick_v${version}.${ext}",
      "unpackDirName": "AhBiShare_OneClick_RAM",
      "requestExecutionLevel": "admin"
    }
  }
}
