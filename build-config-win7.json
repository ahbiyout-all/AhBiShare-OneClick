{
  "appId": "com.ahbiyout.ahbishare.oneclick.win7",
  "productName": "AhBiShare_OneClick_Win7",
  "copyright": "Copyright © 2026 AhBiYout. All rights reserved.",
  "electronVersion": "21.4.4",
  "compression": "maximum",
  "asar": true,
  "files": [
    "dist/**/*",
    "main.js",
    "preload.js",
    "portableStore.js",
    "portableUpdater.js",
    "localeHelper.js",
    "package.json",
    "icon.ico",
    "public/config.json",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "extraResources": [
    {
      "from": "scripts/upgradedHostGuestUnblock.bat",
      "to": "scripts/upgradedHostGuestUnblock.bat"
    },
    {
      "from": "LICENSE",
      "to": "LICENSE"
    },
    {
      "from": "NOTICE",
      "to": "NOTICE"
    },
    {
      "from": "THIRD-PARTY-NOTICES.md",
      "to": "THIRD-PARTY-NOTICES.md"
    }
  ],
  "directories": {
    "output": "release-win7"
  },
  "win": {
    "target": [
      "portable"
    ],
    "requestedExecutionLevel": "requireAdministrator",
    "artifactName": "AhBiShare_OneClick_Win7_v${version}.${ext}",
    "icon": "icon.ico"
  },
  "portable": {
    "artifactName": "AhBiShare_OneClick_Win7_v${version}.${ext}",
    "unpackDirName": "AhBiShare_Win7_RAM",
    "requestExecutionLevel": "admin"
  }
}
