# =======================================================================
# AhBiYout Helper - Official Core .gitignore Specification
# Repository: AhBiYout-all/AhBiYout-Helper
# Purpose: Strictly ensure ONLY core build-critical sources, documentation,
# configs, and public assets are tracked on GitHub.
# =======================================================================

# -----------------------------------------------------------------------
# 1. Local GitHub Push, Sync & Developer Scripts (Strict Exclusion)
# -----------------------------------------------------------------------
# These automation scripts are reserved for local maintainer operations
# and must NEVER be uploaded to the public GitHub repository.
# github_sync.bat
# github_release.bat
# prepare_github_core.bat
# scripts/export_github_core.js
github_core/
release_notes_temp.md
RELEASE_CHANGELOG.md

# -----------------------------------------------------------------------
# 2. Node Dependencies & Package Manager Artifacts
# -----------------------------------------------------------------------
node_modules/
.npm/
.pnp
.pnp.js
package-lock.json.bak
bun.lock
bun.lockb
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------
# 3. Build Outputs, Bundles & Packaging Artifacts
# -----------------------------------------------------------------------
/dist/
/dist-ssr/
/dist_electron/
/build/
/bin/
/release/
/release-lite/
/modules/
/public/modules/
.vite/
.turbo/
.cache/
out/
target/

# -----------------------------------------------------------------------
# 4. Native & Compiled Binaries (C++, Windows PE, Rust, Objects)
# -----------------------------------------------------------------------
*.exe
*.dll
*.so
*.dylib
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.a
*.idb
*.pch
*.res
*.res.*
ahbiyout_core.exe
AhBiYout_*.exe
AhBi*.dll

# -----------------------------------------------------------------------
# 5. Tauri & Rust Native Build Artifacts
# -----------------------------------------------------------------------
src-tauri/target/
src-tauri/bin/

# -----------------------------------------------------------------------
# 6. Windows Installers & Packages
# -----------------------------------------------------------------------
*.msi
*.appx
*.zip
*.7z
*.rar
*.tar.gz

# -----------------------------------------------------------------------
