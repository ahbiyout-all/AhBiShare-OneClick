# =======================================================================
# AhBiShare OneClick - Curated Core Repository .gitignore
# Repository: https://github.com/ahbiyout-all/AhBiShare-OneClick
# Policy: Track ONLY core source code, official docs, build/CI configs,
#         and root build.bat. Strictly exclude local push scripts,
#         platform prompt assets, build binaries, and runtime user data.
# =======================================================================

# -----------------------------------------------------------------------
# 1. Local GitHub Push, Maintainer & Release Automation Scripts
# -----------------------------------------------------------------------
push_github.bat
push_github*.bat
build_release.bat
github_core/
release_notes_temp.md
RELEASE_CHANGELOG.md

# -----------------------------------------------------------------------
# 2. Accidental Nested Paths, AI Studio Metadata & Prompt Assets
# -----------------------------------------------------------------------
/app/
.aistudio/
metadata.json
/public/assets/aistudio/

# -----------------------------------------------------------------------
# 3. Runtime User Data, Portable Credentials, Profiles & Updater Temp
# -----------------------------------------------------------------------
*.portable.json
*.portable.corrupt-*.json
*.location.json
*.location.corrupt-*.json
/locations/
AhBiShare_CrossOS_Sync_Bridge*.json
AhBiShare_Legacy_Win7_Win8_Kit/
AhBiShare_*.bat
AhBiShare_*.reg
Backup_Before_Apply/
_ahbishare_update/
*.part
*apply_portable_update.ps1

# -----------------------------------------------------------------------
