# -----------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.pfx

# -----------------------------------------------------------------------
# 8. Logs & Diagnostic Traces
# -----------------------------------------------------------------------
logs/
Logs/
*.log
npm-debug.log*
yarn-debug.log*

# -----------------------------------------------------------------------
# 9. IDE, Editor & OS Generated Files
# -----------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------
# 10. Temporary, Scratch & Generator Scripts
# -----------------------------------------------------------------------
temp/
tmp/
*.tmp
*.temp
*.bak
check_*.ts
check_*.js
fix_*.ts
fix_*.py
fix_*.js
clean_*.ts
final_*.ts
find_*.ts
restore.js
