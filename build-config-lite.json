{
  "appId": "com.ahbiyout.ahbishare.oneclick",
  "productName": "AhBiShare_OneClick_Lite",
  "copyright": "Copyright © 2026 AhBiYout. All rights reserved.",
  "compression": "maximum",
  "asar": true,
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "electronLanguages": [
    "ko",
    "en-US"
  ],
  "afterPack": "scripts/prune_electron_pack.js",
  "files": [
    "dist/**/*",
    "main.js",
    "preload.js",
    "portableStore.js",
    "portableUpdater.js",
    "localeHelper.js",
    "package.json",
    "icon.ico",
    "public/config.json",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md",
    "!**/node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "scripts/upgradedHostGuestUnblock.bat",
      "to": "scripts/upgradedHostGuestUnblock.bat"
    },
    {
      "from": "LICENSE",
      "to": "LICENSE"
    },
    {
      "from": "NOTICE",
      "to": "NOTICE"
    },
    {
      "from": "THIRD-PARTY-NOTICES.md",
      "to": "THIRD-PARTY-NOTICES.md"
    }
  ],
  "directories": {
    "output": "release-lite"
  },
  "win": {
    "target": [
      "portable"
    ],
    "requestedExecutionLevel": "requireAdministrator",
    "artifactName": "AhBiShare_OneClick-Lite_v${version}.${ext}",
    "icon": "icon.ico"
  },
  "portable": {
    "artifactName": "AhBiShare_OneClick-Lite_v${version}.${ext}",
    "unpackDirName": "AhBiShare_OneClick_Lite_RAM",
    "requestExecutionLevel": "admin"
  }
}
